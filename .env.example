# Copy thanh .env va doi cac mat khau truoc khi chay.
# Khong commit file .env. Khong doi POSTGRES_PASSWORD cua volume DB cu chi bang cach sua .env.
POSTGRES_USER=todo
POSTGRES_PASSWORD=ChangeThisPassword123
POSTGRES_DB=todo

# Tai khoan PostgreSQL quyen hep cho app/Gunicorn (phai khac POSTGRES_USER, khong phai owner/superuser).
APP_DB_USER=todo_app
APP_DB_PASSWORD=ChangeThisAppPassword123

# Cau hinh Grafana chay sau Nginx subpath /grafana/.
# Discord webhook khong dat trong .env ma luu rieng tai secrets/discord_webhook_url (ngoai Git).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPassword123
GRAFANA_ROOT_URL=http://todo-devops.duckdns.org/grafana/
